.DS_Store
*.pyc
*.swp
*.txt
__pycache__
.cache
.pytest_cache
.tox
.eggs
*.egg-info
.idea/
*.iml
.vscode/
.venv/
.fleet/
.cache/
# --- Grafana (live bind-mount at ./pi-hole/grafana) ---
# dashboards/ and provisioning/ are intended config and MUST be tracked.
# Only ignore runtime data regenerated by the container at runtime.
pi-hole/grafana/grafana.db*
pi-hole/grafana/png/
pi-hole/grafana/plugins/
pi-hole/grafana/log/
pi-hole/grafana/unified-search/

# Pi-hole runtime, backups and secrets
pi-hole/.env
pi-hole/etc-pihole/*.db
pi-hole/etc-pihole/*.db-*
pi-hole/etc-pihole/*.pem
pi-hole/etc-pihole/*.crt
pi-hole/etc-pihole/cli_pw
pi-hole/etc-pihole/dhcp.leases
pi-hole/etc-pihole/hosts/
pi-hole/etc-pihole/gravity_backups/
pi-hole/etc-pihole/config_backups/
pi-hole/etc-pihole/listsCache/
pi-hole/etc-pihole/migration_backup/
pi-hole/etc-pihole/logrotate

# Ignore generated TLS and cert files if present
*.key
*.crt
*.pem

# Self-managed / regenerated by running services — do NOT track.
# FTL rewrites these on every start/reload, so tracking them only creates
# permanent phantom diffs in the working tree.
pi-hole/etc-pihole/pihole.toml
pi-hole/etc-pihole/dnsmasq.conf

# Live runtime data / pid files (bind-mounted volumes)
pi-hole/unbound/*.pid
pi-hole/unbound/var/log/*.log
pi-hole/uptime-kuma/kuma.db*
AGENTS.md
