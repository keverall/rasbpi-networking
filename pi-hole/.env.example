# Copy this to .env and edit values before running
TZ=Europe/London
WEBPASSWORD=ChangeMe
DNS1=1.1.1.1
DNS2=1.0.0.1
# SERVERIP should be the IP address of your Raspberry Pi on the LAN
# If your Pi uses DHCP (dynamic IP), you can run the helper script to
# auto-detect and populate this value, or set SERVERIP=auto and run
# `./generate-env.sh` which will replace SERVERIP=auto with the detected IP.
SERVERIP=auto
